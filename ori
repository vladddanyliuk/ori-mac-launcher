#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$ROOT_DIR/lib/common.sh"
# shellcheck source=lib/platform.sh
source "$ROOT_DIR/lib/platform.sh"
# shellcheck source=lib/whisky.sh
source "$ROOT_DIR/lib/whisky.sh"
# shellcheck source=lib/steam.sh
source "$ROOT_DIR/lib/steam.sh"

usage() {
  cat <<'TXT'
Ori Mac Launcher

Usage:
  ./ori              Auto-detect an installed Ori game and launch it
  ./ori blind        Launch Ori and the Blind Forest
  ./ori blind-de     Launch Ori and the Blind Forest: Definitive Edition
  ./ori wotw         Launch Ori and the Will of the Wisps
  ./ori --steam      Open Windows Steam
  ./ori --doctor     Print diagnostics
  ./ori --game-logs [blind|blind-de|wotw]
                     Print the newest Unity game log
  ./ori --dxmt-logs [blind|blind-de|wotw]
                     Print recent DXMT renderer logs
  ./ori --self-test  Validate runtime/prefix without Steam login
  ./ori --logs       Reveal log directory in Finder
  ./ori --reset      Reset the Ori bottle after confirmation
  ./ori --help       Show this help
TXT
}

run_game() {
  local requested="${1:-}"

  platform_check
  ensure_runtime
  ensure_ori_bottle
  select_game_for_run "$requested" || exit $?

  if ori_is_installed; then
    # Previous Steam/CEF crashes can keep helper processes alive in the bottle.
    # Kill them before registry/backend tuning starts so they cannot emit a new
    # libcef breakpoint during an otherwise Steam-free launch.
    kill_wine_session
  fi

  apply_game_tuning

  if ! ori_is_installed; then
    warn "$GAME_NAME is not installed yet."
    ensure_steam
    ensure_ori_installed_interactive || exit $?
  else
    info "Installed game detected; Steam client is not needed for gameplay launch."
  fi

  launch_ori || exit $?
}

main() {
  init_paths
  rotate_logs
  exec > >(tee -a "$CURRENT_LOG") 2>&1
  trap 'on_error "$?" "$LINENO" "$BASH_COMMAND"' ERR

  local command="${1:-run}"
  case "$command" in
    run)
      run_game ""
      ;;
    blind|first|261570)
      run_game "blind"
      ;;
    blind-de|de|definitive|387290)
      run_game "blind-de"
      ;;
    wotw|wisps|1057090)
      run_game "wotw"
      ;;
    --steam)
      platform_check
      ensure_runtime
      ensure_ori_bottle
      ensure_steam
      select_installed_game 1 || true
      apply_game_tuning
      launch_steam
      ;;
    --doctor)
      doctor
      ;;
    --game-logs)
      show_game_logs "${2:-}"
      ;;
    --dxmt-logs)
      show_dxmt_logs "${2:-}"
      ;;
    --self-test)
      platform_check
      ensure_runtime
      ensure_ori_bottle
      select_installed_game 1 || true
      apply_game_tuning
      runtime_self_test
      ;;
    --logs)
      mkdir -p "$LOG_DIR"
      open "$LOG_DIR"
      ;;
    --reset)
      reset_bottle
      ;;
    -h|--help)
      usage
      ;;
    *)
      error "Unknown option: $command"
      usage
      exit 64
      ;;
  esac
}

main "$@"
